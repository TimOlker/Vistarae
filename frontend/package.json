{
  "name": "vistarae-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint:extension": "prettier --ignore-path ../.prettierignore --check \"../extension/**/*.{js,css,html}\"",
    "format:extension": "prettier --ignore-path ../.prettierignore --write \"../extension/**/*.{js,css,html}\"",
    "codegen": "openapi-typescript ../openapi.json -o ./src/types/api.ts",
    "generate:types": "openapi-typescript ../specs/007-ui-edit-poi-enhancements/contracts/poi-edit-api.yaml -o ./src/types/poi-edit-api.ts",
    "generate:types:main": "openapi-typescript ../specs/008-ui-main-page-enhancements/contracts/main-page-api.yaml -o ./src/types/main-page-api.ts"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "exifreader": "^4.23.4",
    "idb": "^8.0.0",
    "lucide-react": "^0.453.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supercluster": "^8.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^24.1.1",
    "openapi-typescript": "^7.4.1",
    "prettier": "^3.1.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "vitest": "^2.0.5"
  }
}
