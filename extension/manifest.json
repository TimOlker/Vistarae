{
  "manifest_version": 3,
  "name": "Vistarae - Travel POI Capture",
  "version": "1.0.0",
  "description": "Capture points of interest, scenic overlooks, trails, and travel dreams into PostGIS with AI extraction and geocoding.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8030/*",
    "http://127.0.0.1:8030/*",
    "https://*.supabase.co/*",
    "https://*.atlasobscura.com/*",
    "https://*.tripadvisor.com/*",
    "https://*.roadsideamerica.com/*",
    "https://*.locationscout.net/*",
    "https://*.shothotspot.com/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "capture-to-vistarae": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capture highlighted text to Vistarae"
    }
  },
  "action": {
    "default_title": "Vistarae - Open POI Browser (or Ctrl+Shift+S to capture)"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content/overlay.css",
        "icons/*",
        "browser/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
