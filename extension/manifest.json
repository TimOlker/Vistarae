{
  "manifest_version": 3,
  "name": "Vistarae - POI & Travel Capture Engine",
  "version": "1.0.0",
  "description": "Capture travel dreams, scenic overlooks, trails, and POIs across the web with automated geocoding and desktop photo folder access.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Vistarae — Open POI Browser (or Ctrl+Shift+S to capture)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*.amazonaws.com/*",
    "https://*.cloudfront.net/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8030/*",
    "https://*.google.com/maps/*",
    "https://*.roadtrippers.com/*",
    "https://*.tripadvisor.com/*",
    "https://*.atlasobscura.com/*",
    "https://*.wikipedia.org/*"
  ],
  "externally_connectable": {
    "matches": ["https://*.cloudfront.net/*", "http://localhost:5173/*"]
  },
  "commands": {
    "capture-to-vistarae": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capture travel POI or highlighted text from active page with Vistarae"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content_loader.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/overlay.css",
        "content/content_script.js",
        "content/parsers/*",
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
