# Environment Configuration for Vistarae

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vistarae
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/vistarae
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vistarae
POSTGRES_PORT=5432

# Google Gemini API (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash-lite

# Geocoding (OSM Nominatim)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=VistaraeTravelEngine/1.0
NOMINATIM_RATE_LIMIT_SEC=1.0

# Observability & OpenTelemetry
OTEL_SERVICE_NAME=vistarae-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_ENABLED=true

# Server Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8030
LOG_LEVEL=INFO
CORS_ORIGINS=["chrome-extension://*","http://localhost:3000","http://localhost:8030"]

# Photoscraping Configuration
PHOTOSCRAPER_DB_USER=tim@olker.us

